# Copy to .env. Every line is optional; the defaults are the ones in
# docker-compose.yml.

# WebMCP is behind a Chrome origin trial (Chrome 149–156). Register the exact
# origin you will serve from — scheme, host and port, e.g.
# https://klipvia.example.com — at https://developer.chrome.com/origintrials
# and paste the token here. It is a public value: it is sent as a response
# header to every visitor, and it only works for the origin it names.
#
# Without it the editor still runs; `document.modelContext` just is not there,
# the header pill reads "webmcp off", and a visitor has to set
# chrome://flags/#enable-webmcp-testing themselves. On localhost the flag is
# the only way either way — origin trials do not cover it.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Where the two services listen on your machine.
KLIPVIA_PORT=8080
STUDIO_PORT=3000
